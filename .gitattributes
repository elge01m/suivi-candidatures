# Preserve Linux-compatible line endings after a Windows checkout.
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.png binary
*.pdf binary
deploy/nginx/suivi-logrotate text eol=lf

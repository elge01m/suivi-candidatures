# Local PostgreSQL connection settings; .env is ignored by Git.
# Never commit .env or share its password in chat or logs.
# Django loads .env with python-dotenv; existing environment variables take priority.
DB_NAME=suivi_candidatures
DB_USER=suivi_candidatures_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Development optional external key; production requires a strong independent key.
DJANGO_SECRET_KEY=

# Gmail OAuth: fill these values only in the ignored local .env file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback/
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/
# Independent Fernet key; never print it or reuse Django's SECRET_KEY.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Separate Fernet key for imported message content, mailbox identity and cursors.
GMAIL_MESSAGE_ENCRYPTION_KEY=
# Gemini server-side only; never expose this key to Vite or browser clients.
GEMINI_API_KEY=

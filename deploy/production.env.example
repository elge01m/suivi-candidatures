# TEMPLATE ONLY. Actual file: /etc/suivi-candidatures/backend.env, root:suivi 0640.
# systemd EnvironmentFile syntax, not a shell script. No export, interpolation or tracing.
DJANGO_SETTINGS_MODULE=config.production_settings
DJANGO_LOAD_DOTENV=0
DJANGO_SECRET_KEY=
APP_ORIGIN=https://candidatures.example.invalid
DJANGO_ALLOWED_HOSTS=candidatures.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://candidatures.example.invalid
DJANGO_STATIC_ROOT=/srv/suivi-candidatures/current/backend/staticfiles
DB_NAME=suivi_candidatures
DB_USER=suivi_candidatures_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Loopback only. Remote DB: verify-full + trusted CA, never disable certificate verification.
DB_SSLMODE=disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://candidatures.example.invalid/api/gmail/callback/
OAUTH_SUCCESS_REDIRECT_URL=https://candidatures.example.invalid/
GOOGLE_TOKEN_ENCRYPTION_KEY=
GMAIL_MESSAGE_ENCRYPTION_KEY=
GEMINI_API_KEY=
